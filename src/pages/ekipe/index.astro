---
import Layout from '../../layouts/Layout.astro';
import TeamCard from '../../components/TeamCard.astro';
import { ekipe } from '../../data/ekipe';
import { klub } from '../../data/klub';
import { snapshot } from '../../lib/data';
import { formatStamp } from '../../lib/format';
---

<Layout title="Ekipe" opis="Pet ekipa OK Štrigova u sezoni 2026./27.: tri seniorske, U13 i U11, s mjestom na tablici, trenerom i kontaktom.">
  <div class="page-head">
    <div class="wrap">
      <h1>Ekipe</h1>
      <p>Sezona {klub.sezona}: tri seniorske ekipe, mala odbojka U13 i mini odbojka U11</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <ol class="ekipe-kartice">{ekipe.map((e) => <TeamCard ekipa={e} />)}</ol>
      <p class="muted small">Poredak sa stranica saveza, osvježeno {formatStamp(snapshot.generatedAt)}.</p>
    </div>
  </section>
</Layout>

<style>
  .ekipe-kartice {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
</style>

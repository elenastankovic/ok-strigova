---
import Layout from '../layouts/Layout.astro';
import { p } from '../lib/putanja';
import UtakmiceSadrzaj from '../components/stranice/UtakmiceSadrzaj.astro';
import EkipeSadrzaj from '../components/stranice/EkipeSadrzaj.astro';
import NatjecanjaSadrzaj from '../components/stranice/NatjecanjaSadrzaj.astro';
import OKlubuSadrzaj from '../components/stranice/OKlubuSadrzaj.astro';
import UpravaSadrzaj from '../components/stranice/UpravaSadrzaj.astro';
import KontaktSadrzaj from '../components/stranice/KontaktSadrzaj.astro';
import Izvori from '../components/Izvori.astro';
import { klub } from '../data/klub';
import { competitionFor, competitionShortName, upcoming } from '../lib/data';
import { formatRange, formatWhenFull } from '../lib/format';

const sljedeca = upcoming[0];
const sljedecaLiga = sljedeca ? competitionFor(sljedeca.competitionId) : undefined;
const sljedecaDomaca = sljedeca ? sljedeca.clubTeams.includes(sljedeca.home) : false;

// Naslovnica redom prikazuje sadržaj svih stranica; izbornik na njoj skače na ove dijelove (id).
const dijelovi = [
  { id: 'utakmice', naslov: 'Utakmice', podnaslov: 'Idući tjedni i zadnji rezultati svih ekipa kluba', Sadrzaj: UtakmiceSadrzaj, svojstva: { skraceno: true } },
  { id: 'ekipe', naslov: 'Ekipe', podnaslov: `Sezona ${klub.sezona}: seniorke, kadetkinje, mlađe kadetkinje, mala odbojka U13 i mini odbojka U11`, Sadrzaj: EkipeSadrzaj },
  { id: 'natjecanja', naslov: 'Natjecanja', podnaslov: 'Lige u kojima ove sezone nastupaju ekipe kluba, s poretkom', Sadrzaj: NatjecanjaSadrzaj, svojstva: { bezIzvora: true } },
  { id: 'o-klubu', naslov: 'O klubu', podnaslov: `Odbojkaški klub Štrigova, osnovan ${klub.osnovan}`, Sadrzaj: OKlubuSadrzaj },
  { id: 'uprava', naslov: 'Uprava', podnaslov: 'Tko vodi klub i kamo želimo ići', Sadrzaj: UpravaSadrzaj },
];
---

<Layout>
  <section class="hero">
    <div class="hero-video" aria-hidden="true">
      <video src={p('/video/slavlje.mp4')} data-od="2" autoplay muted loop playsinline preload="auto"></video>
    </div>
    <div class="wrap hero-grid">
      <div class="hero-tekst">
        <h1>Odbojka u Štrigovi od {klub.godinaOsnutka}.</h1>
        <p class="lead">
          Pet ženskih ekipa, od mini odbojke do seniorki. Treniramo i igramo u dvorani Osnovne
          škole Štrigova, a vikendima nas gledate u 3. HOL Sjever i 4. HOL Međimurje.
        </p>
        <div class="hero-akcije">
          <a class="btn btn-primary" href="#upisi">Dođi na trening</a>
          <a class="btn btn-outline" href="#utakmice">Raspored i rezultati</a>
        </div>
      </div>
      <aside class="sljedeca" aria-labelledby="sljedeca-naslov">
        <h2 id="sljedeca-naslov">Sljedeća utakmica</h2>
        {
          sljedeca && sljedecaLiga ? (
            <>
              <p class="sljedeca-liga">{competitionShortName(sljedecaLiga) + (sljedeca.round ? `, ${sljedeca.round}. kolo` : '')}</p>
              <p class="sljedeca-par">
                <span>{sljedeca.home}</span>
                <span class="sljedeca-crtica">–</span>
                <span>{sljedeca.away}</span>
              </p>
              <p class="sljedeca-datum">
                {sljedeca.scheduledAt ? formatWhenFull(sljedeca.scheduledAt) : formatRange(sljedeca.roundDates)}
              </p>
              <p class="sljedeca-mjesto">{sljedeca.venue ?? (sljedecaDomaca ? klub.dvorana.naziv : 'Gostovanje')}</p>
              {!sljedeca.scheduledAt && <p class="sljedeca-napomena">termin još nije određen</p>}
              {sljedeca.status === 'postponed' && <p class="sljedeca-napomena">odgođeno</p>}
            </>
          ) : (
            <p class="sljedeca-datum">Trenutno nema zakazanih utakmica.</p>
          )
        }
      </aside>
    </div>
  </section>

  {
    dijelovi.map(({ id, naslov, podnaslov, Sadrzaj, svojstva }) => (
      <div class="dio" id={id}>
        <header class="dio-glava">
          <div class="wrap">
            <h2>{naslov}</h2>
            <p>{podnaslov}</p>
          </div>
        </header>
        <Sadrzaj {...svojstva} />
      </div>
    ))
  }


  <div class="dio" id="kontakt">
    <header class="dio-glava">
      <div class="wrap">
        <h2>Kontakt</h2>
        <p>Javite se telefonom i dogovorite prvi dolazak na trening</p>
      </div>
    </header>
    <KontaktSadrzaj />
  </div>

  <Izvori />
</Layout>

<script>
  // Video na vrhu vrti se samo između sekundi data-od i data-do (bez data-do do kraja videa).
  // Posjetiteljima koji su isključili animacije video stoji na jednom kadru.
  const video = document.querySelector<HTMLVideoElement>('.hero-video video');
  if (video) {
    const od = Number(video.dataset.od ?? 0);
    const doKraja = video.dataset.do ? Number(video.dataset.do) : Infinity;
    const bezAnimacija = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const uRaspon = () => {
      if (video.currentTime < od || video.currentTime >= doKraja) video.currentTime = od;
    };
    if (bezAnimacija) {
      video.removeAttribute('autoplay');
      video.pause();
      video.addEventListener('loadedmetadata', () => (video.currentTime = od + 2));
    } else {
      video.addEventListener('loadedmetadata', uRaspon);
      video.addEventListener('timeupdate', uRaspon);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--modra-tamna);
    color: var(--bijela);
    border-bottom: 6px solid var(--narancasta);
  }

  /* Tamni sloj preko videa, jači s lijeve strane gdje je tekst. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(13, 37, 72, 0.92) 0%, rgba(13, 37, 72, 0.68) 45%, rgba(13, 37, 72, 0.25) 100%);
  }

  /* Uspravni video (464 × 832) slavlja u krug; na širokom ekranu vidi se pojas oko ekipe (60 % visine). */
  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .hero h1 {
    color: var(--bijela);
    margin-bottom: 0.4em;
  }

  .hero .lead {
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-akcije {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .sljedeca {
    justify-self: end;
    width: min(100%, 380px);
    background: var(--bijela);
    color: var(--tinta);
    border-radius: var(--radius);
    border-top: 8px solid var(--narancasta);
    padding: 1.4rem 1.5rem 1.3rem;
    box-shadow: 0 24px 60px rgba(8, 24, 52, 0.45);
  }

  .sljedeca h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--siva);
    margin-bottom: 0.2rem;
  }

  .sljedeca p {
    margin: 0;
  }

  .sljedeca .sljedeca-liga {
    margin-bottom: 0.9rem;
  }

  .sljedeca .sljedeca-datum {
    margin-top: 0.9rem;
  }

  .sljedeca-liga {
    font-size: 0.9rem;
    color: var(--siva);
  }

  .sljedeca-par {
    display: flex;
    flex-direction: column;
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 88%;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--modra);
  }

  .sljedeca-crtica {
    color: var(--narancasta);
    font-size: 1.2rem;
    line-height: 1;
    padding-block: 0.15rem;
  }

  .sljedeca-datum {
    font-weight: 600;
  }

  .sljedeca-mjesto {
    font-size: 0.95rem;
  }

  .sljedeca-napomena {
    font-size: 0.85rem;
    color: var(--siva);
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero::before {
      background: rgba(13, 37, 72, 0.75);
    }

    /* Na mobitelu je vrh visok, a kartica sljedeće utakmice prekriva donji dio:
       video se pomiče gore da ekipa bude iznad kartice. */
    .hero-video {
      top: -22%;
      bottom: 22%;
    }

    .sljedeca {
      justify-self: stretch;
      width: 100%;
    }
  }

  /* Naslov svakog dijela: svijetla podloga, velik plavi naslov i narančasta crtica ispod. */
  .dio-glava {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .dio + .dio .dio-glava {
    border-top: 1px solid var(--crta);
  }

  .dio-glava h2 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    font-stretch: 90%;
    line-height: 1;
    color: var(--modra);
    margin-bottom: 0.35em;
  }

  .dio-glava h2::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 5px;
    margin-top: 0.6rem;
    border-radius: 3px;
    background: var(--narancasta);
  }

  .dio-glava p {
    margin: 0;
    font-size: 1.15rem;
    color: var(--siva);
  }

  /* Prvi odjeljak ispod naslova dijela ne treba dodatni razmak na vrhu. */
  .dio-glava + :global(.section) {
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }
</style>

---
import type { Competition, CompetitionGroup } from '../lib/data';
import { teamInStandings, teamTone } from '../lib/data';
import { p } from '../lib/putanja';

interface Props {
  competition: Competition;
  group: CompetitionGroup;
  caption?: string;
}

const { competition, group, caption } = Astro.props;
---

<div class="tablica-wrap">
  <table class="tablica">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        <th class="num" scope="col" abbr="Mjesto">#</th>
        <th scope="col" class="ekipa">Ekipa</th>
        <th class="num" scope="col" abbr="Odigrano">Ut.</th>
        <th class="num" scope="col" abbr="Pobjede">Pob.</th>
        <th class="num" scope="col" abbr="Porazi">Por.</th>
        <th class="num" scope="col">Setovi</th>
        <th class="num siroko" scope="col">Poeni</th>
        <th class="num" scope="col">Bodovi</th>
      </tr>
    </thead>
    <tbody>
      {
        group.standings.map((r) => {
          const team = r.isClub ? teamInStandings(competition, r.team) : undefined;
          return (
            <tr class:list={[{ istaknuto: r.isClub }, teamTone(team)]}>
              <td class="num">{r.rank}.</td>
              <td class="ekipa">{team ? <a href={p(`/ekipe/${team.slug}`)}>{r.team}</a> : r.team}</td>
              <td class="num">{r.played}</td>
              <td class="num">{r.won}</td>
              <td class="num">{r.lost}</td>
              <td class="num">
                {r.setsWon}:{r.setsLost}
              </td>
              <td class="num siroko">
                {r.pointsWon}:{r.pointsLost}
              </td>
              <td class="num">{r.points}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .siroko {
      display: none;
    }
  }
</style>

---
import type { Ekipa } from '../data/ekipe';
import { competitionShortName, plural, primaryStanding, teamsBySlug } from '../lib/data';
import { p } from '../lib/putanja';

interface Props {
  ekipa: Ekipa;
}

const { ekipa: e } = Astro.props;
const team = e.snapshotSlug ? teamsBySlug.get(e.snapshotSlug) : undefined;
const standing = team ? primaryStanding(team) : null;
const natjecanje = standing
  ? competitionShortName(standing.competition) + (standing.group.name ? `, skupina ${standing.group.name}` : '')
  : (e.natjecanje ?? 'Natjecanje još nije objavljeno');
const stanje = standing
  ? `${plural(standing.row.points, 'bod', 'boda', 'bodova')} iz ${plural(standing.row.played, 'utakmice', 'utakmice', 'utakmica')}, ${plural(standing.row.won, 'pobjeda', 'pobjede', 'pobjeda')} i ${plural(standing.row.lost, 'poraz', 'poraza', 'poraza')}`
  : null;
const href = team ? p(`/ekipe/${team.slug}`) : null;
---

<li class:list={['ekipa-red', { prva: e.prva }]}>
  <div class="e-ime">
    <strong>{href ? <a href={href}>{e.naziv}</a> : e.naziv}</strong>
    <span>{e.kategorija}</span>
  </div>
  <div class="e-liga">{natjecanje}</div>
  <div class="e-stanje">
    {
      standing ? (
        <>
          <span class="e-mjesto">
            {standing.row.rank}. od {standing.group.standings.length}
          </span>
          <span class="e-bilanca">{stanje}</span>
        </>
      ) : (
        <span class="muted">{team ? 'Natjecanje nema tablicu poretka' : 'Čeka početak natjecanja'}</span>
      )
    }
  </div>
</li>

<style>
  .ekipa-red {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 1rem 0 1rem 1rem;
    border-bottom: 1px solid var(--crta);
    border-left: 4px solid transparent;
  }

  .ekipa-red.prva {
    border-left-color: var(--narancasta);
    background: var(--bijela);
  }

  .e-ime {
    display: flex;
    flex-direction: column;
  }

  .e-ime strong {
    font-size: 1.15rem;
    font-stretch: 92%;
  }

  .e-ime a {
    text-decoration: none;
  }

  .e-ime a:hover {
    text-decoration: underline;
  }

  .e-ime span {
    color: var(--siva);
    font-size: 0.9rem;
  }

  .e-stanje {
    display: flex;
    flex-direction: column;
  }

  .e-mjesto {
    color: var(--modra);
    font-weight: 700;
    font-size: 1.1rem;
    font-stretch: 92%;
  }

  .e-bilanca {
    color: var(--siva);
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .ekipa-red {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

---
// Sadržaj stranice Natjecanja; koristi ga i naslovnica.
// bezIzvora: bez popisa izvora na dnu (naslovnica ga prikazuje skroz na kraju stranice).
import Standings from '../Standings.astro';
import Izvori from '../Izvori.astro';
import { p } from '../../lib/putanja';
import { competitionShortName, competitionsByPriority } from '../../lib/data';

interface Props {
  bezIzvora?: boolean;
}

const { bezIzvora = false } = Astro.props;
---

{
  competitionsByPriority().map((c) => (
    <section class="section" id={c.id}>
      <div class="wrap">
        <div class="section-head">
          <h2>
            <a href={p(`/natjecanja/${c.id}`)}>{competitionShortName(c)}</a>
          </h2>
          <a href={c.url} rel="noopener">
            Službena stranica
          </a>
        </div>
        <p class="muted">
          {c.category}. Naše ekipe: {c.clubTeams.join(', ')}.
          {c.groups.length > 1 && ` Natjecanje ima ${c.groups.length} skupine.`}
          {c.groups.length === 0 && ' Turnir bez tablice poretka.'}
        </p>
        {c.groups.map((g) => (
          <div class="skupina">
            {g.name && <h3>Skupina {g.name}</h3>}
            <Standings competition={c} group={g} caption={g.name ? `Skupina ${g.name}` : 'Poredak'} />
          </div>
        ))}
        <p>
          <a href={p(`/natjecanja/${c.id}`)}>Sve utakmice natjecanja po kolima</a>
        </p>
      </div>
    </section>
  ))
}

{!bezIzvora && <Izvori />}

<style>
  .section-head h2 a {
    text-decoration: none;
  }

  .section-head h2 a:hover {
    text-decoration: underline;
  }

  .skupina {
    margin-bottom: 1.5rem;
  }

  .skupina h3 {
    margin-bottom: 0.5rem;
  }
</style>

---
// Sadržaj stranice Utakmice; koristi ga i naslovnica.
// skraceno: samo idući tjedni, bez odigranih utakmica, s poveznicom na cijeli raspored (naslovnica).
import WeekSection from '../WeekSection.astro';
import { p } from '../../lib/putanja';
import { groupByWeek, results, upcoming } from '../../lib/data';
import { formatRange } from '../../lib/format';

interface Props {
  skraceno?: boolean;
}

const { skraceno = false } = Astro.props;
const sviNadolazeci = groupByWeek(upcoming);
const odigrani = groupByWeek(results);
const nadolazeci = skraceno ? sviNadolazeci.slice(0, 2) : sviNadolazeci;
---

<section class="section">
  <div class="wrap">
    <h2 class="veliki">Nadolazeće</h2>
    {nadolazeci.map((w) => <WeekSection razina={3} title={formatRange([w.start, w.end])} matches={w.matches} showTeam />)}
    {nadolazeci.length === 0 && <p class="muted">Nema zakazanih utakmica.</p>}
    {
      skraceno && sviNadolazeci.length > nadolazeci.length && (
        <p class="vise">
          <a href={p('/utakmice')}>Cijeli raspored sezone</a>
        </p>
      )
    }
  </div>
</section>

{
  !skraceno && (
    <section class="section">
      <div class="wrap">
        <h2 class="veliki">Odigrano</h2>
        {odigrani.map((w) => (
          <WeekSection razina={3} title={formatRange([w.start, w.end])} matches={w.matches} showTeam />
        ))}
        {odigrani.length === 0 && <p class="muted">Još nema odigranih utakmica.</p>}
      </div>
    </section>
  )
}

<style>
  .veliki {
    margin-bottom: 1.5rem;
  }

  .vise a {
    font-weight: 700;
  }
</style>

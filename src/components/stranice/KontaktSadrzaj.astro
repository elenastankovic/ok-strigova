---
// Sadržaj stranice Kontakt; koristi ga i naslovnica.
import { klub } from '../../data/klub';
import Mreze from '../Mreze.astro';

const daniKratko = ['P', 'U', 'S', 'Č', 'P', 'S', 'N'];
const daniPuno = ['ponedjeljak', 'utorak', 'srijeda', 'četvrtak', 'petak', 'subota', 'nedjelja'];
/** ['utorak', 'srijeda', 'petak'] → "utorak, srijeda i petak" */
const popis = (r: string[]) => (r.length > 1 ? `${r.slice(0, -1).join(', ')} i ${r[r.length - 1]}` : (r[0] ?? ''));
---

<section class="section">
  <div class="wrap grid-3">
    <div class="kontakt-blok">
      <h3>Klub</h3>
      <address>
        {klub.naziv}<br />
        {klub.adresa}<br />
        {klub.postanskiBroj}
      </address>
      <p class="small muted">OIB {klub.oib}</p>
    </div>
    <div class="kontakt-blok">
      <h3>Telefon</h3>
      {
        klub.kontaktOsobe.map((o) => (
          <p>
            <span class="veliki-broj"><a href={o.telefonHref}>{o.telefon}</a></span><br />
            {o.ime}, {o.uloga.toLowerCase()}
          </p>
        ))
      }
    </div>
    <div class="kontakt-blok">
      <h3>Dvorana</h3>
      <address>
        {klub.dvorana.naziv}<br />
        {klub.dvorana.adresa}
      </address>
      <p><a href={klub.dvorana.karta} rel="noopener">Prikaži na karti</a></p>
    </div>
    <div class="kontakt-blok">
      <h3>Pratite nas</h3>
      <p class="small muted">Novosti, fotografije s utakmica i obavijesti o treninzima.</p>
      <Mreze />
    </div>
  </div>
</section>

<section class="section" id="upisi">
  <div class="wrap grid-2">
    <div class="prose">
      <h2>Upisi i prvi trening</h2>
      <p>
        Klub prima djevojčice i djevojke svih uzrasta. Najmlađe počinju u mini odbojci U11, zatim
        slijede mala odbojka U13, mlađe kadetkinje, kadetkinje i seniorke, pa svaka igračica ima ekipu prema svojim godinama i
        iskustvu.
      </p>
      <p>
        Za prvi trening nije potrebno ništa osim sportske odjeće i tenisica za dvoranu. Kontakt osoba za upise je
        {klub.upisi.ime}. Prije prvog dolaska nazovite <a href={klub.upisi.telefonHref}>{klub.upisi.telefon}</a> i
        dogovorite termin.
      </p>
      <a class="btn btn-primary upisi-gumb" href={klub.upisi.telefonHref}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"
          ></path>
        </svg>
        <span>
          Nazovi {klub.upisi.nazovi}
          <strong>{klub.upisi.telefon}</strong>
        </span>
      </a>
    </div>
    <div class="kontakt-blok">
      <h3>Što ponijeti</h3>
      <ul>
        <li>sportsku odjeću i tenisice za dvoranu</li>
        <li>bocu vode</li>
        <li>za mlađe od 18 godina, roditelja na prvi trening</li>
      </ul>
    </div>
  </div>

  <div class="wrap">
    <h3 class="treninzi-naslov">Termini treninga</h3>
    <ul class="treninzi">
      {
        klub.treninzi.map((t) => (
          <li class:list={['trening', t.ton]}>
            <p class="trening-ekipa">{t.ekipa}</p>
            <p class="trening-vrijeme">
              {t.od}
              <span>–</span>
              {t.do}
            </p>
            <ol class="tjedan" aria-label={`Dani: ${t.dani.map((d) => daniPuno[d - 1]).join(', ')}`}>
              {daniKratko.map((d, i) => (
                <li class:list={{ aktivan: t.dani.includes(i + 1) }} aria-hidden="true">
                  {d}
                </li>
              ))}
            </ol>
            <p class="trening-dani">{popis(t.dani.map((d) => daniPuno[d - 1]))}</p>
          </li>
        ))
      }
    </ul>
    <p class="small muted">Svi treninzi su u dvorani OŠ Štrigova.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>Savezi i službene tablice</h2>
    <ul class="rule-list">
      <li>
        <a href={klub.savezi.osvz.url} rel="noopener">{klub.savezi.osvz.naziv}</a>
        <span class="muted">, vodi 3. HOL Sjever u kojoj igra prva ekipa</span>
      </li>
      <li>
        <a href={klub.savezi.osmz.klub} rel="noopener">{klub.savezi.osmz.naziv}</a>
        <span class="muted">, vodi 4. HOL Međimurje te prvenstva u maloj i mini odbojci</span>
      </li>
      <li>
        <a href={klub.savezi.hos.url} rel="noopener">{klub.savezi.hos.naziv}</a>
        <span class="muted">, krovni savez i registar klubova</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Gumb za poziv ispod teksta o upisima: "Nazovi Elenu" i broj ispod. */
  .upisi-gumb {
    gap: 0.8rem;
    margin-top: 0.25rem;
    padding: 0.75rem 1.4rem;
  }

  .upisi-gumb span {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-align: left;
  }

  .upisi-gumb strong {
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
  }

  .treninzi-naslov {
    font-size: 1.4rem;
    margin: clamp(2rem, 5vw, 3rem) 0 1rem;
  }

  .treninzi {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
  }

  .trening {
    background: var(--bijela);
    border: 1px solid var(--crta);
    border-top: 6px solid var(--ton-jaka, var(--modra));
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem 1.2rem;
  }

  .trening p {
    margin: 0;
  }

  .trening-ekipa {
    font-weight: 700;
    color: var(--modra);
  }

  .trening-vrijeme {
    margin: 0.2rem 0 0.9rem !important;
    font-size: 1.9rem;
    font-weight: 800;
    font-stretch: 88%;
    line-height: 1.1;
    color: var(--modra-tamna);
    font-variant-numeric: tabular-nums;
  }

  .trening-vrijeme span {
    color: var(--ton-jaka, var(--narancasta));
    padding-inline: 0.15em;
  }

  .tjedan {
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .tjedan li {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 2.1rem;
    border-radius: 50%;
    background: var(--papir);
    color: var(--siva);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tjedan li.aktivan {
    background: var(--ton, var(--modra-svijetla));
    color: var(--modra-tamna);
    box-shadow: inset 0 0 0 2px var(--ton-jaka, var(--modra));
  }

  .trening-dani {
    font-size: 0.85rem;
    color: var(--siva);
  }
</style>

---
// Poveznice na Instagram i Facebook kluba, s ikonom. Boju nasljeđuju od okoline (currentColor).
// samoIkone: okrugli gumbi bez teksta (zaglavlje uz logo).
import { klub } from '../data/klub';

interface Props {
  class?: string;
  samoIkone?: boolean;
}

const { class: klasa, samoIkone = false } = Astro.props;
const { instagram, facebook } = klub.mreze;
const velicina = samoIkone ? 18 : 20;
---

<ul class:list={['mreze', { 'mreze-ikone': samoIkone }, klasa]}>
  <li>
    <a href={instagram.url} rel="noopener" target="_blank" aria-label={samoIkone ? `${instagram.naziv} ${instagram.korisnik}` : undefined} title={samoIkone ? instagram.naziv : undefined}>
      <svg viewBox="0 0 24 24" width={velicina} height={velicina} aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"></rect>
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"></circle>
      </svg>
      {!samoIkone && <span>{instagram.naziv} <span class="mreze-korisnik">{instagram.korisnik}</span></span>}
    </a>
  </li>
  <li>
    <a href={facebook.url} rel="noopener" target="_blank" aria-label={samoIkone ? `${facebook.naziv} ${facebook.korisnik}` : undefined} title={samoIkone ? facebook.naziv : undefined}>
      <svg viewBox="0 0 24 24" width={velicina} height={velicina} aria-hidden="true">
        <path
          fill="currentColor"
          d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"
        ></path>
      </svg>
      {!samoIkone && <span>{facebook.naziv} <span class="mreze-korisnik">{facebook.korisnik}</span></span>}
    </a>
  </li>
</ul>

<style>
  .mreze {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .mreze a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
  }

  .mreze svg {
    flex: none;
  }

  .mreze-korisnik {
    font-weight: 400;
    opacity: 0.8;
  }

  .mreze-ikone {
    display: flex;
    gap: 0.35rem;
  }

  .mreze-ikone a {
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--modra-svijetla);
    color: var(--modra);
  }

  .mreze-ikone a:hover {
    background: var(--modra);
    color: var(--bijela);
  }
</style>

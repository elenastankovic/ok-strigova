---
import type { Match } from '../lib/data';
import { clubOutcome, clubTeamsOf, competitionFor, competitionShortName, teamFor, teamShort, teamTone } from '../lib/data';
import { formatRangeShort, formatResult, formatSets, formatShortDate, formatTime, formatWeekday, formatWeekdayShort } from '../lib/format';
import { p } from '../lib/putanja';

interface Props {
  match: Match;
  showTeam?: boolean;
  showCompetition?: boolean;
}

const { match: m, showTeam = false, showCompetition = true } = Astro.props;

const outcome = clubOutcome(m);
const result = formatResult(m);
const time = m.scheduledAt ? formatTime(m.scheduledAt) : null;
const competition = competitionFor(m.competitionId);
const clubTeams = clubTeamsOf(m);
const isBye = m.status === 'bye';
const byeTeam = m.home === '0' ? m.away : m.home;

let day = '';
let date = '';
if (m.scheduledAt) {
  day = formatWeekday(m.scheduledAt);
  date = formatShortDate(m.scheduledAt);
} else if (m.roundDates.length > 0) {
  const first = m.roundDates[0]!;
  const last = m.roundDates[m.roundDates.length - 1]!;
  day = first === last ? formatWeekday(first) : `${formatWeekdayShort(first)} – ${formatWeekdayShort(last)}`;
  date = formatRangeShort(m.roundDates, false);
}
const tone = (name: string) => (m.clubTeams.includes(name) ? teamTone(teamFor(m, name)) : undefined);
const note = m.status === 'postponed' ? 'odgođeno' : m.status === 'tbd' ? 'termin nije određen' : null;
---

<li class:list={['mc', { 'mc-pobjeda': outcome === 'win', 'mc-poraz': outcome === 'loss', 'mc-slobodno': isBye }]}>
  <div class="mc-kad">
    <span class="mc-dan">{day || 'datum'}</span>
    <span class="mc-datum">{date || 'nepoznat'}</span>
    <span class:list={['mc-vrijeme', { 'mc-vrijeme-nema': !time }]}>{time ?? '–'}</span>
  </div>
  <div class="mc-tijelo">
    {
      showCompetition && competition && (
        <a class:list={['mc-liga', teamTone(clubTeams[0])]} href={p(`/natjecanja/${competition.id}`)}>
          {competitionShortName(competition) + (m.round ? `, ${m.round}. kolo` : '')}
        </a>
      )
    }
    {
      isBye ? (
        <p class="mc-par">
          <span class:list={['nasa', tone(byeTeam)]}>{byeTeam}</span>
          <span class="mc-slobodno-kolo">slobodno kolo</span>
        </p>
      ) : (
        <p class="mc-par">
          <span class="mc-ekipa">
            <span class:list={[{ nasa: m.clubTeams.includes(m.home) }, tone(m.home)]}>{m.home}</span>
          </span>
          {result ? <span class="mc-rezultat">{result}</span> : <span class="mc-rezultat mc-vs">–</span>}
          <span class="mc-ekipa mc-gost">
            <span class:list={[{ nasa: m.clubTeams.includes(m.away) }, tone(m.away)]}>{m.away}</span>
          </span>
        </p>
      )
    }
    {
      (note || outcome || m.venue || m.sets.length > 0 || (showTeam && clubTeams.length > 0)) && (
        <p class="mc-meta">
          {note && <span class="mc-napomena">{note}</span>}
          {outcome && <span class="mc-ishod">{outcome === 'win' ? 'pobjeda' : 'poraz'}</span>}
          {m.venue && <span>{m.venue}</span>}
          {m.sets.length > 0 && <span class="num">po setovima {formatSets(m.sets)}</span>}
          {showTeam &&
            clubTeams.map((t) => (
              <a class:list={['mc-cip', teamTone(t)]} href={p(`/ekipe/${t.slug}`)}>
                {teamShort(t)}
              </a>
            ))}
        </p>
      )
    }
  </div>
</li>

<style>
  .mc {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--crta);
  }

  .mc-kad {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .mc-dan {
    font-size: 0.8rem;
    color: var(--siva);
    text-transform: lowercase;
  }

  .mc-datum {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .mc-vrijeme {
    font-weight: 600;
    color: var(--modra);
  }

  .mc-vrijeme-nema {
    color: var(--siva);
    font-weight: 400;
  }

  .mc-liga {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--modra);
    text-decoration: none;
    margin-bottom: 0.35rem;
  }

  .mc-liga::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--ton-jaka, var(--siva));
    flex: none;
  }

  .mc-liga:hover {
    text-decoration: underline;
    color: var(--modra);
  }

  .mc-par {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.05rem;
  }

  .mc-gost {
    text-align: right;
  }

  .nasa {
    font-weight: 700;
    color: var(--modra);
  }

  .nasa[class*='ton-'] {
    background: var(--ton);
    color: var(--modra-tamna);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius);
    box-shadow: inset 4px 0 0 var(--ton-jaka);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .mc-cip[class*='ton-'] {
    background: var(--ton);
    color: var(--modra-tamna);
    box-shadow: inset 0 0 0 1.5px var(--ton-jaka);
  }

  .mc-cip[class*='ton-']:hover {
    background: var(--ton-jaka);
    color: var(--bijela);
  }

  .mc-rezultat {
    font-weight: 800;
    font-size: 1.2rem;
    font-stretch: 90%;
    font-variant-numeric: tabular-nums;
    background: var(--modra);
    color: var(--bijela);
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius);
    min-width: 3.2rem;
    text-align: center;
  }

  .mc-pobjeda .mc-rezultat {
    background: var(--narancasta);
    color: var(--modra-tamna);
  }

  .mc-vs {
    background: var(--modra-svijetla);
    color: var(--modra);
  }

  .mc-slobodno-kolo {
    color: var(--siva);
  }

  .mc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    color: var(--siva);
  }

  .mc-ishod {
    font-weight: 600;
    color: var(--modra);
  }

  .mc-pobjeda .mc-ishod {
    color: var(--narancasta-tamna);
  }

  .mc-napomena {
    font-style: italic;
  }

  .mc-cip {
    display: inline-block;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--modra-svijetla);
    color: var(--modra);
    text-decoration: none;
    font-weight: 600;
  }

  .mc-cip:hover {
    background: var(--modra);
    color: var(--bijela);
  }

  @media (max-width: 560px) {
    .mc {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .mc-kad {
      flex-direction: row;
      gap: 0.5rem;
      align-items: baseline;
    }

    .mc-par {
      font-size: 1rem;
    }
  }
</style>

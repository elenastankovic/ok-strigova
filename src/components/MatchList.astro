---
import type { Match } from '../lib/data';
import MatchCard from './MatchCard.astro';

interface Props {
  matches: Match[];
  showTeam?: boolean;
  showCompetition?: boolean;
  empty?: string;
}

const { matches, showTeam = false, showCompetition = true, empty = 'Nema utakmica.' } = Astro.props;
---

{
  matches.length > 0 ? (
    <ul class="utakmice">
      {matches.map((m) => (
        <MatchCard match={m} showTeam={showTeam} showCompetition={showCompetition} />
      ))}
    </ul>
  ) : (
    <p class="muted">{empty}</p>
  )
}

<style>
  .utakmice {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--crta);
  }
</style>
